{
  // Workspace settings for RTL. Extensions: see .vscode/extensions.json.

  // Editor lint = Verilator, with the search paths CI gets from the filelists.
  // .vscode/verilator.f is generated by `make ide`; the git hooks (make hooks)
  // and make check refresh it, so it is never run by hand.
  "verilog.linting.linter": "verilator",
  "verilog.linting.verilator.arguments": "-Wall -f .vscode/verilator.f",

  // Verible reads the repository's .rules.verible_lint (naming rule constants).
  "verible.arguments": ["--rules_config_search"],

  // Format on demand only (Shift+Alt+F). Saving must never reformat an
  // emacs-generated wrapper or a file under vendor/.
  "[systemverilog]": { "editor.formatOnSave": false },
  "[verilog]": { "editor.formatOnSave": false }
}
