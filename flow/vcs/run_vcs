#!/usr/bin/env bash
# Compile one block with Synopsys VCS, on a machine that has a licence (the
# training server). The flags are those of DM/VCS/run_vcs in MCU_guide_ws.
#
#   bash flow/vcs/run_vcs <block> [top]
#   make vcs BLOCK=<block>
#
# The design comes from design/<block>/<block>.f, read with -F so its relative
# paths resolve from the filelist -- the same list lint, SIM and SYN use. The
# top defaults to the wrapper, the last rtl/*.sv line of the filelist.
# CI does not run this: VCS is licensed, so CI lints with Verilator instead.
set -euo pipefail

block=${1:?usage: run_vcs <block> [top]}
flist="design/${block}/${block}.f"
[ -f "$flist" ] || { echo "no $flist"; exit 1; }
command -v vcs >/dev/null 2>&1 || { echo "vcs not found -- run this on the server"; exit 1; }
top=${2:-$(grep -oE 'rtl/[A-Za-z0-9_]+\.sv' "$flist" | tail -1 | xargs -n1 basename | sed 's/\.sv$//')}
out="build/vcs/${block}"
mkdir -p "$out"

vcs -sverilog +vcs+lic+wait \
    -timescale=1ns/1ps \
    -F "$flist" \
    -top "$top" \
    -debug_access -kdb \
    +error+100 \
    +lint=all \
    -Mdir="$out/csrc" -o "$out/simv" \
    -l "$out/comp.log"
