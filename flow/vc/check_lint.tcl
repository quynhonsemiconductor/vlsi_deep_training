# VC Static LINT, batch only. Adapted from the assistant's DM_LINT/VC_Static
# flow (share_review): same tool calls, config generated by run_vc.sh from the
# block's own filelist, and the vendor IP waiver list derived from it.
source -echo ./lint_config.tcl

file mkdir $SESSION_DIR
file mkdir $REPORT_DIR

# Default rule deck: the tool's own initial-RTL methodology. A project goal
# (QNSC_LINT_RULE) can replace it later by setting LINT_RULESETUP in the config.
if {[info exists LINT_RULESETUP] && $LINT_RULESETUP ne ""} {
    source $LINT_RULESETUP
}

analyze -format sverilog -vcs "-F $RTL_FILELIST" -define "$RTL_DEFINES -timescale=1ns/1ps"
elaborate $TOP_MODULE
check_lint
save_session -session ${SESSION_DIR}/${SESSION_NAME}

if {$WAIVER_IP_LIST ne ""} {
    foreach ip $WAIVER_IP_LIST {
        puts "Apply waiver IP: $ip"
        waive_lint -ip $ip -add waiver_$ip
    }
}

report_violations -app lint -verbose -include_compressed -limit 0 \
    -file ${REPORT_DIR}/lint_full.rpt
report_violations -app lint -only_waived -include_compressed -verbose -limit 0 \
    -file ${REPORT_DIR}/lint_waived.rpt

quit
