#!/bin/tcsh
# Compile the timer block (apb_timer_unit plus its wrapper) with VCS, from this directory, on a
# compute node of the training server (after: module load synopsys/vcs/W-2024.09-SP1).
#   cd design/timer/vcs ; ./run_vcs
# Read comp.log: "Error-" must be 0, and every "Lint-" on our own files.
# Lint- on vendor/pulp-platform/timer_unit is upstream and not edited.
# Schematic: verdi -dbdir simv.daidir &

setenv DESIGN m_qnsc_wrap_timer

vcs -sverilog +vcs+lic+wait \
    -timescale=1ns/1ps \
    -F filelist.f \
    -top $DESIGN \
    -debug_access -kdb \
    +error+100 \
    +lint=all \
    -l comp.log
