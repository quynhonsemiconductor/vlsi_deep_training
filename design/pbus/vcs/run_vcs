#!/bin/tcsh
# Compile the pbus block with VCS, from this directory, on a compute node of the
# training server (after: module load synopsys/vcs/W-2024.09-SP1).
#   cd design/pbus/vcs ; ./run_vcs
# Read comp.log: "Error-" must be 0, and every "Lint-" on our own files.
# The 28 Lint-[UI] (i_clk/i_rstn of the 14 generated arbiters) are expected:
# see design/pbus/README.md and waivers.vlt.
# Schematic: verdi -dbdir simv.daidir &

setenv DESIGN m_qnsc_wrap_pbus

vcs -sverilog +vcs+lic+wait \
    -timescale=1ns/1ps \
    -F filelist.f \
    -top $DESIGN \
    -debug_access -kdb \
    +error+100 \
    +lint=all \
    -l comp.log
