`verilator_config
// DMA lint waivers. Every line carries its reason (CONTRIBUTING.md, LINT stage).

// dma_axi32 writes `#1` intra-assignment delays in its always blocks (for
// example prgen_min3.v:71). Verilator 5 stops on them unless --timing or
// --no-timing is given, and lint_all.sh gives neither. The delays are
// simulation-only and vendor/ is never edited.
lint_off -rule NEEDTIMINGOPT -file "*vendor/freecores/dma_axi/*"

// Left open on purpose: no peripheral in QSoC takes a clear (the UART request
// falls when RHR is read), AXI4 has no WID, and no QSOC block reads idle (SCRC
// has no DMA idle input).
lint_off -rule PINCONNECTEMPTY -file "*design/dma/rtl/m_qnsc_wrap_dma.sv" -match "*'periph_tx_clr'*"
lint_off -rule PINCONNECTEMPTY -file "*design/dma/rtl/m_qnsc_wrap_dma.sv" -match "*'periph_rx_clr'*"
lint_off -rule PINCONNECTEMPTY -file "*design/dma/rtl/m_qnsc_wrap_dma.sv" -match "*'WID0'*"
lint_off -rule PINCONNECTEMPTY -file "*design/dma/rtl/m_qnsc_wrap_dma.sv" -match "*'idle'*"
