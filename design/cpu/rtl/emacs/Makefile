# The cpu wrapper is generated by the shared emacs flow (flow/emacs/wrap.mk):
#   make wrap BLOCK=cpu     (from the repo root)
# ibex_top's package-typed ports and parameters are handled by
# flow/emacs/fix_pkg_ports.py. PARAM_FIX drops the rvfi_* lines: RVFI is not
# built, and verilog-mode lists those ports because it does not evaluate `ifdef.
# resolve_pkg_consts.py turns ibex_pkg::<constant> into its number, read from
# ibex_pkg.sv, so the .src.sv keeps the names and the wrapper carries the values.
DESIGN    = m_qnsc_wrap_cpu
PARAM_FIX = /rvfi_/d
include ../../../../flow/emacs/wrap.mk

.PHONY: pkg_consts
rtl_fix: pkg_consts
pkg_consts: emacs_wrapper
	$(PYTHON) $(WRAP_MK_DIR)resolve_pkg_consts.py $(DST_FILE) $(EMACS_FILELIST) filelist_emacs_bridge.f ibex_pkg qnsc_cpu2axi_pkg
