ôn bật (SCRC), nên giữa hai miền không có mạch CDC.&lt;br&gt;&lt;br&gt;Cổng AXI ở biên là cổng phẳng (không struct). Hai khối assign ghép và tách tín hiệu với struct bên trong.&lt;br&gt;&lt;br&gt;emacs sinh: cổng clock/reset và chân của 3 instance. Cổng APB viết tay trong .src.sv.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="380" y="900" width="560" height="300" as="geometry"/></mxCell><mxCell id="5194" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="290" height="440" as="geometry"/></mxCell><mxCell id="5195" value="&lt;b&gt;Chú giải ký hiệu&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="706" width="270" height="26" as="geometry"/></mxCell><mxCell id="5196" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="34" y="770" as="sourcePoint"/><mxPoint x="104" y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5197" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="63" y="779" as="sourcePoint"/><mxPoint x="75" y="761" as="targetPoint"/></mxGeometry></mxCell><mxCell id="5198" value='&lt;span style="font-size:12px"&gt;54&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="742" width="40" height="18" as="geometry"/></mxCell><mxCell id="5199" value='&lt;span style="font-size:12px"&gt;Bus nhiều bit. Số cạnh gạch chéo là số bit của bus (ví dụ 54 bit).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="746" width="185" height="52" as="geometry"/></mxCell><mxCell id="5200" value="" style="triangle;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;strokeWidth=1.5;rotation=90;" vertex="1" parent="1"><mxGeometry x="62" y="826" width="16" height="16" as="geometry"/></mxCell><mxCell id="5201" value='&lt;span style="font-size:12px"&gt;Tam giác trắng ở viền khung: cổng của module. Mũi tam giác chỉ chiều vào hoặc ra.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="812" width="185" height="52" as="geometry"/></mxCell><mxCell id="5202" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=10;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="44" y="882" width="56" height="40" as="geometry"/></mxCell><mxCell id="5203" value="" style="triangle;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;strokeWidth=1.5;rotation=90;" vertex="1" parent="1"><mxGeometry x="66" y="910" width="12" height="14" as="geometry"/></mxCell><mxCell id="5204" value='&lt;span style="font-size:12px"&gt;Tam giác nhỏ ở cạnh khối: chân clock (clk_i). Đường nối vào đó là dây clock.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="878" width="185" height="52" as="geometry"/></mxCell><mxCell id="5205" value='&lt;span style="font-size:12px"&gt;AW 73&lt;br&gt;W 38&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="34" y="950" width="80" height="36" as="geometry"/></mxCell><mxCell id="5206" value='&lt;span style="font-size:12px"&gt;AW, W, AR, B, R là 5 kênh của AXI4. Số bên cạnh là số bit của kênh đó.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="944" width="185" height="52" as="geometry"/></mxCell><mxCell id="5207" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=10 6;" vertex="1" parent="1"><mxGeometry x="42" y="1016" width="60" height="38" as="geometry"/></mxCell><mxCell id="5208" value='&lt;span style="font-size:12px"&gt;Khung nét đứt: một miền clock và reset.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="1010" width="185" height="52" as="geometry"/></mxCell><mxCell id="5209" value='&lt;span style="font-size:12px"&gt;&lt;i&gt;w_slv_reqs&lt;/i&gt;&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="34" y="1086" width="80" height="28" as="geometry"/></mxCell><mxCell id="5210" value='&lt;span style="font-size:12px"&gt;Chữ nghiêng: tên dây bên trong module.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="120" y="1076" width="185" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>