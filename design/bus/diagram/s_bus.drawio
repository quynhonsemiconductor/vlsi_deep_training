12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="1226" width="220" height="36" as="geometry"/></mxCell><mxCell id="369" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="1224" as="sourcePoint"/><mxPoint x="820" y="1188" as="targetPoint"/></mxGeometry></mxCell><mxCell id="370" value="&lt;b&gt;AR ra tới ROM, +2 chu kỳ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="710" y="1226" width="220" height="36" as="geometry"/></mxCell><mxCell id="371" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1060" y="1224" as="sourcePoint"/><mxPoint x="1060" y="1188" as="targetPoint"/></mxGeometry></mxCell><mxCell id="372" value="&lt;b&gt;R về, không thêm trễ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="950" y="1226" width="220" height="36" as="geometry"/></mxCell><mxCell id="373" value='&lt;span style="font-size:12px"&gt;&lt;b&gt;Đọc hình này&lt;/b&gt;&lt;br&gt;Chu kỳ 1: CPU đưa AR, ar_ready = 1 nên bắt tay xong.&lt;br&gt;Chu kỳ 3: AR ra tới ROM. ID thêm 2 bit đầu (01 = cổng vào số 1), từ 5 thành 7 bit.&lt;br&gt;Chu kỳ 5: ROM trả R. S_BUS nhìn 2 bit đầu của ID để đưa về CPU, bỏ 2 bit đó, ID trở lại 5 bit.&lt;br&gt;R đi tổ hợp, không thêm trễ.&lt;br&gt;&lt;br&gt;Địa chỉ 0x0000_0080 là điểm bắt đầu chạy sau reset (ROM + 0x80).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1770" y="330" width="440" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4. Bên trong crossbar" name="4. Bên trong crossbar"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="42" value="&lt;b&gt;axi_xbar: micro-architecture của một cổng vào (demux) và một cổng ra (mux)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=26;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2000" height="40" as="geometry"/></mxCell><mxCell id="43" value="Thanh ghi nét liền: có thật với LatencyMode = CUT_ALL_AX. Nét đứt: bypass, đi thẳng. Mỗi cổng vào có một demux, mỗi cổng ra có một mux." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2200" height="26" as="geometry"/></mxCell><mxCell id="44" value="&lt;b&gt;axi_demux  (một cái cho mỗi cổng vào, gen_slv_port_demux[i])&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;dashed=1;dashPattern=10 6;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1100" height="640" as="geometry"/></mxCell><mxCell id="45" value="&lt;b&gt;AW&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="34" y="176" width="40" height="28" as="geometry"/></mxCell><mxCell id="46" value="&lt;b&gt;W&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=16;align=left;verticalAlign=middle;" vertex="1