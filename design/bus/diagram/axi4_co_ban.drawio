="620" y="840"/><mxPoint x="730" y="840"/><mxPoint x="730" y="866"/></Array></mxGeometry></mxCell><mxCell id="278" value='&lt;span style="font-size:12px"&gt;READY (bên nhận)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="894" width="300" height="38" as="geometry"/></mxCell><mxCell id="279" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="926" as="sourcePoint"/><mxPoint x="1170" y="926" as="targetPoint"/><Array as="points"><mxPoint x="620" y="926"/><mxPoint x="620" y="900"/><mxPoint x="730" y="900"/><mxPoint x="730" y="926"/></Array></mxGeometry></mxCell><mxCell id="280" value='&lt;span style="font-size:12px"&gt;dữ liệu (bên gửi)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="954" width="300" height="38" as="geometry"/></mxCell><mxCell id="281" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="973" as="sourcePoint"/><mxPoint x="1170" y="973" as="targetPoint"/></mxGeometry></mxCell><mxCell id="282" value='&lt;span style="font-size:12px"&gt;D&lt;/span&gt;' style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.18;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="624" y="960" width="102" height="26" as="geometry"/></mxCell><mxCell id="283" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="622" y="830" width="106" height="162" as="geometry"/></mxCell><mxCell id="284" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;chuyển dữ liệu&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="994" width="130" height="20" as="geometry"/></mxCell><mxCell id="285" value='&lt;span style="font-size:14px"&gt;&lt;b&gt;Quy tắc&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Chuyển dữ liệu xảy ra ở chu kỳ có VALID = 1 và READY = 1 (bên nhận lấy dữ liệu ở cạnh lên clock cuối chu kỳ đó).&lt;br&gt;&lt;br&gt;2. Bên gửi bật VALID khi có dữ liệu, không được chờ READY lên rồi mới bật VALID.&lt;br&gt;&lt;br&gt;3. Đã bật VALID thì phải giữ VALID và giữ nguyên dữ liệu cho tới khi bắt tay xong (ví dụ A).&lt;br&gt;&lt;br&gt;4. Bên nhận được phép bật READY trước khi có VALID (ví dụ B), hoặc chờ thấy VALID rồi mới bật.&lt;br&gt;&lt;br&gt;5. READY = 1 mà VALID = 0 thì không có gì được chuyển; VALID = 1 mà READY = 0 thì bên gửi chờ.&lt;br&gt;&lt;br&gt;Quy tắc này áp dụng cho cả 5 kênh. Bên nhận làm chậm luồng dữ liệu bằng cách hạ READY (gọi là back-pressure).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=14;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1250" y="150" width="700" height="700" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3. Giao dịch ghi" name="3. Giao dịch ghi"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="32" value="&lt;b&gt;Giao dịch ghi: burst 4 beat&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=26;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2000" height="40" as="geometry"/></mxCell><mxCell id="33" value="AW gửi địa chỉ một lần, W gửi 4 beat dữ liệu, B phản hồi một lần cho cả burst. Beat thứ 3 bị chờ vì wready = 0." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2200" height="26" as="geometry"/></mxCell><mxCell id="34" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="140" as="sourcePoint"/><mxPoint x="440" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="35" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="140" as="sourcePoint"/><mxPoint x="550" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="140" as="sourcePoint"/><mxPoint x="660" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="37" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="140" as="sourcePoint"/><mxPoint x="770" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="140" as="sourcePoint"/><mxPoint x="880" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="39" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;en