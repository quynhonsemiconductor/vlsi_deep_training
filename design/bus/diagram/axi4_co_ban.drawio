ntSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="748" width="130" height="20" as="geometry"/></mxCell><mxCell id="368" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="772" y="486" width="106" height="260" as="geometry"/></mxCell><mxCell id="369" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;D1&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="748" width="130" height="20" as="geometry"/></mxCell><mxCell id="370" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="992" y="486" width="106" height="260" as="geometry"/></mxCell><mxCell id="371" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;D2&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="748" width="130" height="20" as="geometry"/></mxCell><mxCell id="372" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1102" y="486" width="106" height="260" as="geometry"/></mxCell><mxCell id="373" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;D3, wlast&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="748" width="130" height="20" as="geometry"/></mxCell><mxCell id="374" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1322" y="790" width="106" height="156" as="geometry"/></mxCell><mxCell id="375" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;B&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="948" width="130" height="20" as="geometry"/></mxCell><mxCell id="376" value='&lt;span style="font-size:13px"&gt;&lt;b&gt;Các bước&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chu kỳ 1, kênh AW: master gửi địa chỉ A và awlen = 3, nghĩa là 4 beat. Slave nhận ngay (awready = 1).&lt;br&gt;&lt;br&gt;Chu kỳ 2 đến 6, kênh W: master gửi 4 beat D0 đến D3. Ở chu kỳ 4, wvalid = 1 nhưng wready = 0, nên master giữ D2 và chờ. Beat cuối có wlast = 1.&lt;br&gt;&lt;br&gt;Chu kỳ 8, kênh B: sau khi nhận beat cuối, slave gửi một phản hồi bresp = OKAY cho cả burst.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lưu ý&lt;/b&gt;&lt;br&gt;AW và W độc lập nhau: W có thể đi trước, cùng lúc hoặc sau AW.&lt;br&gt;wstrb có một bit cho mỗi byte, bit nào bằng 1 thì byte đó được ghi.&lt;br&gt;Slave chỉ được trả B sau khi đã nhận cả AW và beat W cuối.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1740" y="200" width="520" height="640" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4. Giao dịch đọc" name="4. Giao dịch đọc"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="42" value="&lt;b&gt;Giao dịch đọc: burst 4 beat&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=26;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2000" height="40" as="geometry"/></mxCell><mxCell id="43" value="AR gửi địa chỉ một lần, slave trả 4 beat dữ liệu qua kênh R. Mỗi beat có rresp riêng, beat cuối có rlast = 1." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2200" height="26" as="geometry"/></mxCell><mxCell id="44" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="140" as="sourcePoint"/><mxPoint x="440" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="45" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="140" as="sourcePoint"/><mxPoint x="550" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="46" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="140" as="sourcePoint"/><mxPoint x="660" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="47" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="140" as="sourcePoint"/><mxPoint x="770" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="48" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="140" as="sourcePoint"/><mxPoint x="880" y="840" as="targetPoint"/></mxGeometry></mxCell><mxCell id="49" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="