ue='&lt;span style="font-size:12px"&gt;R2&lt;/span&gt;' style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.18;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1214" y="596" width="212" height="26" as="geometry"/></mxCell><mxCell id="450" value='&lt;span style="font-size:12px"&gt;R3&lt;/span&gt;' style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.18;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1434" y="596" width="102" height="26" as="geometry"/></mxCell><mxCell id="451" value='&lt;span style="font-size:12px"&gt;rresp[1:0]&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="642" width="360" height="38" as="geometry"/></mxCell><mxCell id="452" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="661" as="sourcePoint"/><mxPoint x="1650" y="661" as="targetPoint"/></mxGeometry></mxCell><mxCell id="453" value='&lt;span style="font-size:12px"&gt;OKAY&lt;/span&gt;' style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.18;whiteSpace=wrap;html=1;strokeWidth=2;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="994" y="648" width="542" height="26" as="geometry"/></mxCell><mxCell id="454" value='&lt;span style="font-size:12px"&gt;rlast&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="694" width="360" height="38" as="geometry"/></mxCell><mxCell id="455" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="726" as="sourcePoint"/><mxPoint x="1650" y="726" as="targetPoint"/><Array as="points"><mxPoint x="1430" y="726"/><mxPoint x="1430" y="700"/><mxPoint x="1540" y="700"/><mxPoint x="1540" y="726"/></Array></mxGeometry></mxCell><mxCell id="456" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="662" y="234" width="106" height="208" as="geometry"/></mxCell><mxCell id="457" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;AR&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="444" width="130" height="20" as="geometry"/></mxCell><mxCell id="458" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="992" y="486" width="106" height="260" as="geometry"/></mxCell><mxCell id="459" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;R0&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="748" width="130" height="20" as="geometry"/></mxCell><mxCell id="460" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1102" y="486" width="106" height="260" as="geometry"/></mxCell><mxCell id="461" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;R1&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1090" y="748" width="130" height="20" as="geometry"/></mxCell><mxCell id="462" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1322" y="486" width="106" height="260" as="geometry"/></mxCell><mxCell id="463" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;R2&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="748" width="130" height="20" as="geometry"/></mxCell><mxCell id="464" value="" style="rounded=0;fillColor=none;strokeWidth=2;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="1432" y="486" width="106" height="260" as="geometry"/></mxCell><mxCell id="465" value='&lt;b&gt;&lt;span style="font-size:11px"&gt;R3, rlast&lt;/span&gt;&lt;/b&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="748" width="130" height="20" as="geometry"/></mxCell><mxCell id="466" value='&lt;span style="font-size:13px"&gt;&lt;b&gt;Các bước&lt;/b&gt;&lt;br&gt;&lt;br&gt;Chu kỳ 1 và 2, kênh AR: master gửi địa chỉ A, arlen = 3. Slave chưa sẵn sàng ở chu kỳ 1 (arready = 0), nên master giữ arvalid và địa chỉ. Bắt tay xong ở chu kỳ 2.&lt;br&gt;&lt;br&gt;Chu kỳ 5 đến 9, kênh R: slave trả 4 beat R0 đến R3. Ở chu kỳ 7, master hạ rready, nên slave giữ R2 và chờ. Beat cuối có rlast = 1.&lt;br&gt;&lt;br&gt;&lt;b&gt;Lưu ý&lt;/b&gt;&lt;br&gt;Từ lúc nhận AR đến beat R đầu có thể mất nhiều chu kỳ, tuỳ slave.&lt;br&gt;Khác với ghi, đọc không có kênh phản hồi riêng: kết quả (rresp) đi cùng từng beat dữ liệu.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1740" y="170" width="520" height="600" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5. Burst: len, size, loại" name="5. Burst: len, size, loại"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="52" value="&lt;b&gt;Burst: số beat, kích thước beat và ba loại burst&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=26;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2000" height="40" as="geometry"/></mxCell><mxCell id="53" value="Địa chỉ và điều khiển chỉ gửi một lần cho cả burst, các beat sau slave tự tính địa chỉ." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2200" height="26" as="geometry"/></mxCell><mxCell id="54" value='&lt;b&gt;Số beat&lt;/b&gt; = AxLEN + 1&lt;br&gt;&lt;b&gt;Byte mỗi beat&lt;/b&gt; = 2 mũ AxSIZE&lt;br&gt;&lt;span style="font-size:12px"&gt;AxSIZE = 2 nghĩa là 4 byte mỗi beat (bus 32 bit rộng 4 byte).&lt;br&gt;AxLEN rộng 8 bit: INCR tối đa 256 beat, FIXED và WRAP tối đa 16 beat.&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=15;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="150" as="geometry"/></mxCell><mxCell id="55" value="&lt;b&gt;INCR&lt;/b&gt; &lt;span style=&quot;font-size:13px&quot;&gt;(AxBURST = 2'b01): địa chỉ tăng dần. Ví dụ araddr = 0x1000, arlen = 3, arsize = 2&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="900" height="28" as="geometry"/></mxCell><mxCell id="56" value='&lt;b&gt;beat 0&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1000&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="195" height="70" as="geometry"/></mxCell><mxCell id="57" value='&lt;b&gt;beat 1&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1004&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="255" y="310" width="195" height="70" as="geometry"/></mxCell><mxCell id="58" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="235" y="345" as="sourcePoint"/><mxPoint x="255" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="59" value='&lt;b&gt;beat 2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1008&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="470" y="310" width="195" height="70" as="geometry"/></mxCell><mxCell id="510" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="345" as="sourcePoint"/><mxPoint x="470" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="511" value='&lt;b&gt;beat 3&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x100C&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="685" y="310" width="195" height="70" as="geometry"/></mxCell><mxCell id="512" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="665" y="345" as="sourcePoint"/><mxPoint x="685" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="513" value='&lt;span style="font-size:12px"&gt;4 beat × 4 byte = 16 byte, địa chỉ cộng thêm 4 sau mỗi beat.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="392" width="880" height="26" as="geometry"/></mxCell><mxCell id="514" value="&lt;b&gt;FIXED&lt;/b&gt; &lt;span style=&quot;font-size:13px&quot;&gt;(AxBURST = 2'b00): mọi beat cùng một địa chỉ. Dùng khi đọc ghi liên tục vào một thanh ghi hay FIFO&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="900" height="28" as="geometry"/></mxCell><mxCell id="515" value='&lt;b&gt;beat 0&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1000&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="195" height="70" as="geometry"/></mxCell><mxCell id="516" value='&lt;b&gt;beat 1&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1000&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="255" y="480" width="195" height="70" as="geometry"/></mxCell><mxCell id="517" value='&lt;b&gt;beat 2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1000&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="470" y="480" width="195" height="70" as="geometry"/></mxCell><mxCell id="518" value='&lt;b&gt;beat 3&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1000&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="685" y="480" width="195" height="70" as="geometry"/></mxCell><mxCell id="519" value="&lt;b&gt;WRAP&lt;/b&gt; &lt;span style=&quot;font-size:13px&quot;&gt;(AxBURST = 2'b10): địa chỉ tăng rồi quay vòng trong một vùng. Ví dụ bắt đầu 0x1008, 4 beat&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="900" height="28" as="geometry"/></mxCell><mxCell id="520" value='&lt;b&gt;beat 0&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1008&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="195" height="70" as="geometry"/></mxCell><mxCell id="521" value='&lt;b&gt;beat 1&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x100C&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="255" y="620" width="195" height="70" as="geometry"/></mxCell><mxCell id="522" value='&lt;b&gt;beat 2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1000&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="470" y="620" width="195" height="70" as="geometry"/></mxCell><mxCell id="523" value='&lt;b&gt;beat 3&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;0x1004&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="685" y="620" width="195" height="70" as="geometry"/></mxCell><mxCell id="524" value='&lt;span style="font-size:12px"&gt;Vùng quay vòng = số beat × byte mỗi beat = 16 byte, căn theo 16 byte (0x1000 đến 0x100F). WRAP chỉ có 2, 4, 8 hoặc 16 beat. Hay dùng để nạp cache line.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="702" width="900" height="44" as="geometry"/></mxCell><mxCell id="525" value="&lt;b&gt;Ranh giới 4 KiB&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;dashed=1;dashPattern=10 6;fontSize=14;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="900" height="200" as="geometry"/></mxCell><mxCell id="526" value='&lt;span style="font-size:13px"&gt;Một burst không được vượt qua ranh giới 4 KiB (địa chỉ có phần 12 bit cao đổi giữa chừng).&lt;br&gt;Lý do: mỗi slave thường nằm gọn trong một vùng 4 KiB, nên burst vượt ranh giới có thể rơi vào hai slave khác nhau.&lt;br&gt;&lt;br&gt;Trong QSOC: CPU chỉ gửi burst 1 beat (len = 0).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="822" width="880" height="160" as="geometry"/></mxCell><mxCell id="527" value="&lt;b&gt;Mã AxBURST và xRESP&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="940" height="28" as="geometry"/></mxCell><mxCell id="528" value="&lt;b&gt;AxBURST&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="140" height="44" as="geometry"/></mxCell><mxCell id="529" value="&lt;b&gt;ý nghĩa&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="140" width="200" height="44" as="geometry"/></mxCell><mxCell id="530" value="2'b00" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="184" width="140" height="44" as="geometry"/></mxCell><mxCell id="531" value="FIXED" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="184" width="200" height="44" as="geometry"/></mxCell><mxCell id="532" value="2'b01" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="228" width="140" height="44" as="geometry"/></mxCell><mxCell id="533" value="INCR" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="228" width="200" height="44" as="geometry"/></mxCell><mxCell id="534" value="2'b10" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="272" width="140" height="44" as="geometry"/></mxCell><mxCell id="535" value="WRAP" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1140" y="272" width="200" height="44" as="geometry"/></mxCell><mxCell id="536" value="&lt;b&gt;xRESP&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="360" width="120" height="44" as="geometry"/></mxCell><mxCell id="537" value="&lt;b&gt;ý nghĩa&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1120" y="360" width="620" height="44" as="geometry"/></mxCell><mxCell id="538" value="&lt;b&gt;ai trả&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1740" y="360" width="200" height="44" as="geometry"/></mxCell><mxCell id="539" value="2'b00" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="404" width="120" height="44" as="geometry"/></mxCell><mxCell id="540" value="OKAY: thành công" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1120" y="404" width="620" height="44" as="geometry"/></mxCell><mxCell id="541" value="slave" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1740" y="404" width="200" height="44" as="geometry"/></mxCell><mxCell id="542" value="2'b01" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="448" width="120" height="44" as="geometry"/></mxCell><mxCell id="543" value="EXOKAY: exclusive access thành công" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1120" y="448" width="620" height="44" as="geometry"/></mxCell><mxCell id="544" value="slave" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1740" y="448" width="200" height="44" as="geometry"/></mxCell><mxCell id="545" value="2'b10" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="492" width="120" height="60" as="geometry"/></mxCell><mxCell id="546" value="SLVERR: slave báo lỗi (ví dụ ghi vào vùng chỉ đọc, tuỳ slave)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1120" y="492" width="620" height="60" as="geometry"/></mxCell><mxCell id="547" value="slave" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1740" y="492" width="200" height="60" as="geometry"/></mxCell><mxCell id="548" value="2'b11" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1000" y="552" width="120" height="60" as="geometry"/></mxCell><mxCell id="549" value="DECERR: không có slave nào ở địa chỉ này" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1120" y="552" width="620" height="60" as="geometry"/></mxCell><mxCell id="550" value="interconnect" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=13;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1740" y="552" width="200" height="60" as="geometry"/></mxCell><mxCell id="551" value='&lt;span style="font-size:13px"&gt;Kênh ghi có một bresp cho cả burst. Kênh đọc có rresp ở từng beat.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="940" height="40" as="geometry"/></mxCell><mxCell id="552" value="&lt;b&gt;wstrb: byte nào được ghi&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="720" width="460" height="28" as="geometry"/></mxCell><mxCell id="553" value="&lt;span style=&quot;font-size:13px&quot;&gt;wstrb có 1 bit cho mỗi byte của wdata. Ví dụ bus 32 bit, wstrb = 4'b0011: chỉ byte 1 và byte 0 được ghi.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="752" width="940" height="40" as="geometry"/></mxCell><mxCell id="554" value='&lt;b&gt;byte 3&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;wstrb = 0: bỏ qua&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="810" width="150" height="70" as="geometry"/></mxCell><mxCell id="555" value='&lt;b&gt;byte 2&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;wstrb = 0: bỏ qua&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="810" width="150" height="70" as="geometry"/></mxCell><mxCell id="556" value='&lt;b&gt;byte 1&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;wstrb = 1: ghi&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1320" y="810" width="150" height="70" as="geometry"/></mxCell><mxCell id="557" value='&lt;b&gt;byte 0&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;wstrb = 1: ghi&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=14;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1480" y="810" width="150" height="70" as="geometry"/></mxCell><mxCell id="558" value='&lt;span style="font-size:13px"&gt;Dùng khi ghi 1 byte (sb) hay 2 byte (sh): master đưa dữ liệu vào đúng làn byte rồi đặt wstrb tương ứng.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="900" width="940" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6. ID và thứ tự" name="6. ID và thứ tự"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="62" value="&lt;b&gt;ID và thứ tự trả lời&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=26;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2000" height="40" as="geometry"/></mxCell><mxCell id="63" value="ID cho biết response thuộc request nào. Khác ID thì slave được trả lẫn thứ tự, cùng ID thì phải giữ thứ tự." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2200" height="26" as="geometry"/></mxCell><mxCell id="64" value="&lt;b&gt;Khác ID: được trả lẫn thứ tự&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="800" height="28" as="geometry"/></mxCell><mxCell id="65" value="&lt;b&gt;Master&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="160" height="50" as="geometry"/></mxCell><mxCell id="66" value="&lt;b&gt;Slave&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="160" height="50" as="geometry"/></mxCell><mxCell id="67" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="190" as="sourcePoint"/><mxPoint x="120" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="68" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="190" as="sourcePoint"/><mxPoint x="600" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="69" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="250" as="sourcePoint"/><mxPoint x="600" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="610" value="AR  id = 1  (đọc vùng chậm)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=1;" vertex="1" parent="1"><mxGeometry x="190" y="220" width="340" height="24" as="geometry"/></mxCell><mxCell id="611" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="350" as="sourcePoint"/><mxPoint x="600" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="612" value="AR  id = 2  (đọc vùng nhanh)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=1;" vertex="1" parent="1"><mxGeometry x="190" y="320" width="340" height="24" as="geometry"/></mxCell><mxCell id="613" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="450" as="sourcePoint"/><mxPoint x="120" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="614" value="R  id = 2  (xong trước, trả trước)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=1;" vertex="1" parent="1"><mxGeometry x="190" y="420" width="340" height="24" as="geometry"/></mxCell><mxCell id="615" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="600" y="550" as="sourcePoint"/><mxPoint x="120" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="616" value="R  id = 1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=1;" vertex="1" parent="1"><mxGeometry x="190" y="520" width="340" height="24" as="geometry"/></mxCell><mxCell id="617" value='&lt;span style="font-size:13px"&gt;Hợp lệ. Master nhìn vào ID của R để biết response nào ứng với request nào. Nhờ vậy slave nhanh không phải chờ slave chậm.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="640" height="130" as="geometry"/></mxCell><mxCell id="618" value='&lt;span style="font-size:11px"&gt;thời gian&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="690" y="190" width="40" height="24" as="geometry"/></mxCell><mxCell id="619" value="&lt;b&gt;Cùng ID: phải giữ thứ tự&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="90" width="800" height="28" as="geometry"/></mxCell><mxCell id="620" value="&lt;b&gt;Master&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="960" y="140" width="160" height="50" as="geometry"/></mxCell><mxCell id="621" value="&lt;b&gt;Slave&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=16;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1440" y="140" width="160" height="50" as="geometry"/></mxCell><mxCell id="622" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="190" as="sourcePoint"/><mxPoint x="1040" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="623" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="190" as="sourcePoint"/><mxPoint x="1520" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="624" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="250" as="sourcePoint"/><mxPoint x="1520" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="625" value="AR  id = 1  (A)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=1;" vertex="1" parent="1"><mxGeometry x="1110" y="220" width="340" height="24" as="geometry"/></mxCell><mxCell id="626" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="350" as="sourcePoint"/><mxPoint x="1520" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="627" value="AR  id = 1  (B)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=1;" vertex="1" parent="1"><mxGeometry x="1110" y="320" width="340" height="24" as="geometry"/></mxCell><mxCell id="628" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="450" as="sourcePoint"/><mxPoint x="1040" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="629" value="R  id = 1  (A, phải trả trước)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=1;" vertex="1" parent="1"><mxGeometry x="1110" y="420" width="340" height="24" as="geometry"/></mxCell><mxCell id="630" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="550" as="sourcePoint"/><mxPoint x="1040" y="550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="631" value="R  id = 1  (B)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=center;verticalAlign=middle;fillColor=#ffffff;spacing=1;" vertex="1" parent="1"><mxGeometry x="1110" y="520" width="340" height="24" as="geometry"/></mxCell><mxCell id="632" value='&lt;span style="font-size:13px"&gt;Bắt buộc. Các giao dịch cùng ID và cùng chiều (đọc với đọc, ghi với ghi) phải được trả đúng thứ tự phát.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="960" y="720" width="640" height="130" as="geometry"/></mxCell><mxCell id="633" value='&lt;span style="font-size:11px"&gt;thời gian&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1610" y="190" width="40" height="24" as="geometry"/></mxCell><mxCell id="634" value='&lt;span style="font-size:13px"&gt;&lt;b&gt;Thêm&lt;/b&gt;&lt;br&gt;Đọc và ghi độc lập: AXI4 không quy định thứ tự giữa một giao dịch đọc và một giao dịch ghi.&lt;br&gt;AXI4 không có WID: dữ liệu ghi của các burst không được xen kẽ nhau, nên beat W đi theo đúng thứ tự AW.&lt;br&gt;Trong QSOC: cầu của CPU luôn dùng ID 0 nên response về đúng thứ tự phát. S_BUS thêm 2 bit vào đầu ID (5 thành 7 bit) để biết response của master nào.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1800" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>