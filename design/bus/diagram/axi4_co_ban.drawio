<mxfile host="app.diagrams.net"><diagram id="1. Năm kênh AXI4" name="1. Năm kênh AXI4"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="12" value="&lt;b&gt;AXI4: 5 kênh độc lập giữa master và slave&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=26;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2000" height="40" as="geometry"/></mxCell><mxCell id="13" value="Mỗi kênh có cặp VALID và READY riêng. Ba kênh đi từ master sang slave (AW, W, AR), hai kênh đi ngược lại (B, R)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2200" height="26" as="geometry"/></mxCell><mxCell id="14" value='&lt;b&gt;Master&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;bên bắt đầu giao dịch&lt;br&gt;(CPU, DMA, SYSDBG)&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=18;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="200" height="760" as="geometry"/></mxCell><mxCell id="15" value='&lt;b&gt;Slave&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;bên trả lời&lt;br&gt;(ROM, RAM, ngoại vi)&lt;/span&gt;' style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=18;align=center;verticalAlign=top;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="1660" y="130" width="200" height="760" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;Giao dịch GHI&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;dashed=1;dashPattern=10 6;fontSize=14;align=left;verticalAlign=top;spacingLeft=1