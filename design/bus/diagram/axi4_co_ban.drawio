0" height="48" as="geometry"/></mxCell><mxCell id="125" value='&lt;span style="font-size:12px"&gt;arid · araddr[31:0] · arlen[7:0] · arsize[2:0] · arburst[1:0]&lt;br&gt;arlock · arcache[3:0] · arprot[2:0] · arqos[3:0] · arregion[3:0]&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="558" width="580" height="56" as="geometry"/></mxCell><mxCell id="126" value='&lt;span style="font-size:13px"&gt;&lt;b&gt;địa chỉ đọc và điều khiển&lt;/b&gt;&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="584" width="300" height="24" as="geometry"/></mxCell><mxCell id="127" value='&lt;span style="font-size:10px"&gt;arvalid · arready (master → slave, slave → master)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="628" width="300" height="22" as="geometry"/></mxCell><mxCell id="128" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=block;endFill=1;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="760" as="sourcePoint"/><mxPoint x="240" y="760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="129" value="&lt;b&gt;R&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=18;strokeWidth=2;fontSize=20;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="880" y="736" width="120" height="48" as="geometry"/></mxCell><mxCell id="130" value='&lt;span style="font-size:12px"&gt;rid · rdata[31:0] · rresp[1:0] · rlast&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="698" width="580" height="56" as="geometry"/></mxCell><mxCell id="131" value='&lt;span style="font-size:13px"&gt;&lt;b&gt;dữ liệu đọc và phản hồi&lt;/b&gt;&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="724" width="300" height="24" as="geometry"/></mxCell><mxCell id="132" value='&lt;span style="font-size:10px"&gt;rvalid · rready (slave → master, master → slave)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="768" width="300" height="22" as="geometry"/></mxCell><mxCell id="133" value='&lt;span style="font-size:13px"&gt;VALID do bên gửi dữ liệu của kênh đó bật, READY do bên nhận bật. Dữ liệu chỉ được chuyển khi cả hai cùng bằng 1.&lt;br&gt;Các kênh không có thứ tự cố định với nhau, trừ hai quy tắc: slave chỉ trả B sau khi nhận xong beat W cuối, và chỉ trả R sau khi nhận AR.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="280" y="905" width="1340" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2. Bắt tay VALID và READY" name="2. Bắt tay VALID và READY"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="22" value="&lt;b&gt;Bắt tay VALID và READY&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=26;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2000" height="40" as="geometry"/></mxCell><mxCell id="23" value="Dữ liệu chỉ được chuyển ở chu kỳ có cả VALID và READY bằng 1. Ba cách xảy ra, đều hợp lệ." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2200" height="26" as="geometry"/></mxCell><mxCell id="24" value="&lt;b&gt;A. VALID lên trước, READY lên sau&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;rounded=0;fontSize=18;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="112" width="800" height="26" as="geometry"/></mxCell><mxCell id="25" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="146" as="sourcePoint"/><mxPoint x="400" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="26" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="146" as="sourcePoint"/><mxPoint x="510" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="146" as="sourcePoint"/><mxPoint x="620" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;startSize=8;endArrow=none;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="730" y="146" as="sourcePoint"/><mxPoint x="730" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" style="edgeStyle=none;html=1;rounded=0;endArrow=bloc