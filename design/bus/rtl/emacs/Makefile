# The bus wrapper is generated by the shared emacs flow (flow/emacs/wrap.mk):
#   make wrap BLOCK=bus     (from the repo root)
# resolve_pkg_consts.py turns qnsc_s_bus_pkg::<constant> and qnsc_pkg::<constant> into
# its number, read from the packages listed in bus.f, so the .src.sv keeps the names
# and the wrapper carries the values. Types (slv_req_t, rule_t, ...) and the
# function-built tables (P_CFG, P_CONNECTIVITY, P_ADDR_MAP, P_APB_ADDR_MAP) stay names.
DESIGN = m_qnsc_wrap_bus
include ../../../../flow/emacs/wrap.mk

.PHONY: pkg_consts
rtl_fix: pkg_consts
pkg_consts: emacs_wrapper
	$(PYTHON) $(WRAP_MK_DIR)resolve_pkg_consts.py $(DST_FILE) ../../bus.f qnsc_s_bus_pkg qnsc_pkg
