+++ b/hw/obi_uart/obi_uart.sv
@@ -26,6 +26,7 @@ module obi_uart #(
 
   output logic     irq_o,   // Interrupt line
   output logic     irq_no,  // Negated Interrupt line
+  output logic     dma_rx_req_o, // QSOC: LSR.data_ready level (RX data waiting), for a DMA request
 
   input  logic     rxd_i,  // Serial Input
   output logic     txd_o,  // Serial Output
@@ -75,7 +76,8 @@ module obi_uart #(
     .obi_rsp_o,
 
     .reg_read_o  (reg_read),
-    .reg_write_i (reg_write)
+    .reg_write_i (reg_write),
+    .dma_rx_req_o (dma_rx_req_o)
   );
 
   ////////////////////////////////////////////////////////////////////////////////////////////////
