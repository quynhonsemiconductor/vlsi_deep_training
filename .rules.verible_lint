# Verible style lint, read by verible-verilog-lint and the Verible editor
# extension. Adjusted where Verible's defaults disagree with
# doc/rules/QNSC_RTL_Design_Naming_Rule.pdf.

# Rule 2.4: parameters and constants are P_/C_ plus uppercase words joined by _.
parameter-name-style=localparam_style:ALL_CAPS;parameter_style:ALL_CAPS
# Tables and generated comments in qnsc_pkg run past Verible's 100 columns.
line-length=length:150
# Rules 2.6 and 2.7 (V1.2), the part of the naming check Verible does exactly;
# CI's naming check (make naming) remains the gate for every rule.
module-filename
one-module-per-file
package-filename
enum-name-style=style_regex:[a-z][a-z0-9_]*_t
struct-union-name-style
