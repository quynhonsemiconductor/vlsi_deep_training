<mxfile host="app.diagrams.net" type="device">
  <diagram name="Reset to application" id="pg0">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rst" value="Power on" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="scrc" value="SCRC: hold the whole chip in reset, clock the IPs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rel" value="SCRC: release the reset of every IP except the CPU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="srel" value="SCRC releases the CPU reset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rom" value="Ibex fetches 0x0000_0080 (ROM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="no boot address mux and no CPU hold:&#10;normal and debug boot both run the ROM" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=8;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="282" width="300" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="uart" value="init UART0 (19200 - 8N1 - polling)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="dl" value="receive the frame from the PC over UART0&#10;(Figure 7-1):&#10;DEBUG_PAYLOAD -&gt; 0x2000_0000 (if DEBUG_PROG = 0x55)&#10;PAYLOAD -&gt; 0x2000_1000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="dbg" value="SYSCSR.DBG_EN = 1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="105" y="520" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="poll" value="CPU polling: read SYSCSR.DBG_EN again&#10;(the CPU runs the ROM; it is not held in reset)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="533" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="pnote" value="leaves the loop when the host writes DBG_BOOT.dbg_en_mask = 1&#10;(SYSDBG bus master, AXI_S0)&#10;at any time: debug request -&gt; debug program at 0x2000_0800,&#10;dret -&gt; back to this loop" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=8;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="590" width="330" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="dnote" value="DBG_EN = DBG_EN pin through 2 FF,&#10;forced to 0 while dbg_en_mask = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=8;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="600" width="300" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="jmp" value="jump to 0x2000_1080 (ISRAM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="330" height="44" as="geometry"/>
        </mxCell>
