        <mxCell id="rom" value="Ibex fetches 0x0000_0080 (ROM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="uart" value="init UART0 (19200 - 8N1 - polling)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="330" height="44" as="geometry"/>
