  <diagram name="Reset to application" id="pg0">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rst" value="Power on" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="hold" value="SCRC holds the chip in reset&#10;and clocks every block (7.3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rel" value="SCRC releases every IP except the CPU,&#10;waits 16 clock cycles (7.5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="cpu" value="SCRC releases the CPU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="rom" value="Ibex fetches 0x0000_0080 (ROM)&#10;_start: sp = 0x3000_8000, boot_main" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="330" height="44" as="geometry"/>
