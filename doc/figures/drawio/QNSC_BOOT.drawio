        <mxCell id="dbg" value="DBG_EN pin = 1?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="105" y="210" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="boot address picked by a hardware mux (o_dbg_en -&gt; boot_addr_i),&#10;in debug boot the ROM never runs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=8;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="256" width="300" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="srel" value="SCRC releases the CPU reset" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="330" height="44" as="geometry"/>
