          <mxGeometry x="45" y="142" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="hdr" value="waiting for the next header byte:&#10;LENGTH, HDR_CRC" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="232" width="270" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="hto" value="new byte within&#10;RX_TIMEOUT polls?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="298" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="h8" value="8 header bytes&#10;received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="388" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="hcr" value="CRC32 = HDR_CRC?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="478" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="hrg" value="LENGTH valid?&#10;(Table 6-1)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="568" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="ackh" value="send ACKH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="658" width="270" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pay" value="waiting for the next payload or PAY_CRC byte;&#10;write the payload to 0x2000_1000 (ISRAM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="724" width="270" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="pto" value="new byte within&#10;RX_TIMEOUT polls?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="790" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="pn" value="all payload and&#10;PAY_CRC bytes received?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="45" y="880" width="220" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="pcr" value="CRC32 = PAY_CRC?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
