          <mxGeometry x="40" y="620" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="application runs from ISRAM" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="330" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="host" value="SYSDBG holds the CPU in reset,&#10;the debug program is loaded to&#10;0x2000_1000 (ISRAM) over JTAG" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
