        <mxCell id="dl" value="receive the frame from the PC over UART0&#10;and write it to 0x2000_1000 (ISRAM)&#10;(Figure 7-1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
