  </diagram>
  <diagram name="JTAG command format" id="pg1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t_in" value="shifted IN on TDI  |  68 bits" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;dashed=1;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="940" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="op" value="op&#10;[1:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="90" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="size" value="size&#10;[1:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="90" width="90" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="addr" value="addr&#10;[31:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="330" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="data" value="data&#10;[31:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="400" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="t_out" value="shifted OUT on TDO  |  same scan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;dashed=1;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="940" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="rdata" value="rdata [31:0]&#10;result of the PREVIOUS command" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="700" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="status" value="status&#10;[1:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="280" width="220" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="leg" value="op:  00 = NOP   |   01 = READ   |   10 = WRITE&#10;size:  00 = byte   |   01 = halfword   |   10 = word   -&gt;  drives mem_be_o&#10;status:  00 = OK   |   01 = BUSY   |   10 = ERROR&#10;addr[31:28] = 0xF  -&gt;  SYSDBG registers   |   otherwise  -&gt;  system bus&#10;the payload always sits in the LOW bits of data: hardware shifts it into the addressed lane&#10;one scan = one command, and the answer arrives on the next scan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="940" height="150" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="SYSDBG command FSM" id="pg2">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="idle" value="IDLE&#10;wait for a command" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="dec" value="DECODE&#10;SYSDBG reg or bus?&#10;reject misaligned" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="loc" value="LOCAL&#10;read/write CTRL,&#10;STATUS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="170" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="axi" value="BUS&#10;issue request,&#10;wait for rsp_valid" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="180" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="done" value="DONE&#10;latch rdata&#10;and status" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="180" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f3leg" value="one scan = one command   |   status reads BUSY while the FSM is not in IDLE&#10;BusTimeout expiry inside BUS sets ERROR and STATUS.bus_timeout but does NOT leave the state:&#10;a granted request cannot be cancelled, so its response is waited for and discarded" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;dashed=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="890" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="idle_dec_0" value="op != NOP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="idle" target="dec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="dec_loc_1" value="addr[31:28] = F" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="loc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="dec_axi_2" value="otherwise" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="axi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="loc_done_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.5;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="loc" target="done">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="axi_done_4" value="rsp_valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="axi" target="done">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="done_idle_5" value="next Capture-DR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=1.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="done" target="idle">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
