        <mxCell id="pads" value="JTAG pads&#10;TCK  TMS&#10;TDI  TDO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="210" width="150" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="ztck" value="TCK clock domain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;dashed=1;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="210" y="60" width="380" height="480" as="geometry"/>
        </mxCell>
        <mxCell id="tap" value="TAP controller&#10;Capture-DR · Shift-DR · Update-DR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="110" width="340" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="acc" value="ACCESS shift register  68 bit&#10;op[1:0] · size[1:0] · addr[31:0] · data[31:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="232" width="340" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="resp" value="response latch&#10;rdata[31:0] · status[1:0]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="350" width="340" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="also" value="also in the chain:&#10;IR 4 bit · IDCODE 32 bit · BYPASS 1 bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="230" y="452" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cdc" value="CDC&#10;req / ack&#10;2-flop sync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="630" y="232" width="110" height="188" as="geometry"/>
        </mxCell>
        <mxCell id="zsys" value="system clock domain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;dashed=1;fontStyle=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="780" y="60" width="430" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="fsm" value="Command FSM&#10;IDLE · DECODE · LOCAL / BUS · DONE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="390" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="regs" value="SYSDBG registers&#10;CTRL · STATUS · ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="232" width="175" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="dreq" value="debug_req logic&#10;CTRL[0] in, halt status out" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=9;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1015" y="232" width="175" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="axim" value="Bus master&#10;req · gnt · rsp_valid · be" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="360" width="390" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="cpu" value="Ibex CPU" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1260" y="205" width="165" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="bus" value="S_BUS&#10;AXI_S0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1260" y="360" width="165" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="steps" value="1  host shifts op, addr and data in on TDI&#10;2  at Update-DR the 68 bits are latched as one command&#10;3  the command crosses into the system clock domain&#10;4  the FSM executes it  |  addr[31:28] = 0xF goes to a SYSDBG register  |  anything else becomes a bus request&#10;5  rdata and status travel back across the CDC&#10;6  they are captured at the next Capture-DR&#10;7  the host shifts them out on TDO  |  so a READ takes two scans: one to ask, one to collect" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;dashed=1;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="20" y="580" width="1405" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="pads_tap_0" value="TMS, TCK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.1199999999999999;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pads" target="tap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="pads_acc_1" value="1  TDI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.35000000000000014;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pads" target="acc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="acc_cdc_2" value="2  Update-DR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.20000000000000012;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="acc" target="cdc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cdc_fsm_3" value="3  cmd req" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.20000000000000012;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdc" target="fsm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_regs_4" value="4a  local" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.15399999999999986;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fsm" target="regs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_axim_5" value="4b  BUS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fsm" target="axim">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="regs_dreq_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.7999999999999997;entryX=0.0;entryY=0.7999999999999997;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="regs" target="dreq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="dreq_cpu_7" value="debug_req" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.25;entryX=0.0;entryY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dreq" target="cpu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cpu_dreq_8" value="debug_mode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.0;exitY=0.8499999999999999;entryX=1.0;entryY=0.8500000000000002;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cpu" target="dreq">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="axim_bus_9" value="axi_from_mem" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="axim" target="bus">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fsm_cdc_10" value="5  rdata, status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.0;exitY=0.7999999999999999;entryX=1.0;entryY=0.7999999999999999;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fsm" target="cdc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cdc_resp_11" value="6  Capture-DR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.0;exitY=0.7999999999999999;entryX=1.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdc" target="resp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="resp_pads_12" value="7  TDO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.85;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="resp" target="pads">
