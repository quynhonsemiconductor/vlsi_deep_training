          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="board_qsoc_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0.0;entryX=0.5;entryY=1.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="board" target="qsoc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Halting the CPU, end to end" id="pg4">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s1" value="1.  PC:  halt()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="600" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2.  PC:  write(0xF000_0000, 0x1)&#10;becomes one 68-bit DR scan" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="144" width="600" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3.  JTAG:  op = WRITE, addr = 0xF000_0000, data = 1&#10;latched at Update-DR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="248" width="600" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="4.  CDC:  the command crosses to the system clock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="352" width="600" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5.  FSM:  DECODE sees addr[31:28] = F, goes to LOCAL,&#10;writes CTRL[0] = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="456" width="600" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="6.  SYSDBG:  debug_req driven high and HELD high" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="600" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="7.  Ibex:  saves PC to dpc, sets dcsr.cause = 3,&#10;jumps to DmHaltAddr, raises debug_mode" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="664" width="600" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="8.  SYSDBG:  STATUS[2] = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="768" width="600" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="s9" value="9.  PC:  read(0xF000_0004), two scans, sees bit 2 set&#10;the CPU is halted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="872" width="600" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="k" value="Colour = who is acting&#10;&#10;blue    the PC&#10;purple  the TCK domain&#10;red     the clock crossing&#10;yellow  SYSDBG, system clock&#10;green   the CPU&#10;&#10;Steps 1-6 are the command path.&#10;Step 7 is the CPU reacting.&#10;Steps 8-9 are how the host&#10;finds out it worked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="720" y="40" width="300" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="k2" value="Resume is the same path&#10;with CTRL[1] instead,&#10;and the core returns&#10;through DRET.&#10;&#10;Reading memory is the same&#10;path with op = READ and an&#10;address that is not 0xF..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;dashed=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="420" width="300" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="s1_s2_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s2_s3_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3">
