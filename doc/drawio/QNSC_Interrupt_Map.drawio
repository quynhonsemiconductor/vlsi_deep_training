        <mxCell id="cpu" value="Ibex&#10;&#10;RV32IMC&#10;&#10;vectored&#10;mtvec" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
