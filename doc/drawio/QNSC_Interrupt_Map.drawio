  <diagram name="The three designs, and what this one trades" id="pg1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="The same 27 sources, three ways" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=12;dashed=1;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="760" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h1" value="OR tree  --  this revision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="116" width="246" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Latched in-house  V2.0-V7.0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="116" width="246" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="rv_plic  V8.0-V10.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="116" width="240" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="11 fast lines + NMI&#10;&#10;mcause names the peripheral&#10;&#10;0 bus access per interrupt&#10;&#10;COMBINATIONAL&#10;&#10;0 flip-flops&#10;&#10;no register, no address" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="156" width="246" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="10 fast lines + NMI&#10;&#10;mcause names the peripheral&#10;&#10;1 bus access (W1C)&#10;&#10;1 cycle&#10;&#10;52 flip-flops&#10;&#10;6 registers on APB_M15" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="156" width="246" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="1 line (irq_external) + NMI&#10;&#10;read the CLAIM register&#10;&#10;2 bus access, 1 blocking&#10;&#10;2 cycles&#10;&#10;258 flip-flops&#10;&#10;10 registers, 4 MiB on AXI_M4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;dashed=0;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="560" y="156" width="240" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="w" value="What the OR tree gives up, stated rather than hidden:&#10;1  a one-cycle pulse arriving while mstatus.MIE is clear is LOST -- recoverable for 10 of 11 pulse&#10;    sources, but NOT for DMA, which has no status register.  That is the one open dependency.&#10;2  priority is FIXED at elaboration: it is the fast-line index, resolved lowest-index-first by Ibex.&#10;3  mcause 16-30 is an Ibex extension, so firmware is tied to this core." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;dashed=0;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="386" width="760" height="92" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
