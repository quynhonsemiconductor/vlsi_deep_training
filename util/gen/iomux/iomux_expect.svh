        t_chk(o_pad_oe[22] === (i_gpio_2_oe[1]), "PIN31 b00 GPIO2_1: OE");
        t_chk(o_gpio_2_in[1] === i_pad_in[22], "PIN31 b00 GPIO2_1: Y");
      end
      2'b01: begin
        t_chk(o_pad_oe[22] === 1'b0, "PIN31 b01 TIM_EXT0: OE = 0");
        t_chk(o_tim_ext[0] === i_pad_in[22], "PIN31 b01 TIM_EXT0: Y");
      end
      2'b10: t_chk(o_pad_oe[22] === 1'b0, "PIN31 b10 unassigned: OE = 0");
      2'b11: t_chk(o_pad_oe[22] === 1'b0, "PIN31 b11 unassigned: OE = 0");
      default: t_chk(1'b0, "t_expect_pad: code is X");
    endcase
    23: case (c)  // PIN32
      2'b00: begin
        t_chk(o_pad_out[23] === (i_gpio_2_out[0]), "PIN32 b00 GPIO2_0: A");
        t_chk(o_pad_oe[23] === (i_gpio_2_oe[0]), "PIN32 b00 GPIO2_0: OE");
        t_chk(o_gpio_2_in[0] === i_pad_in[23], "PIN32 b00 GPIO2_0: Y");
      end
      2'b01: begin
        t_chk(o_pad_oe[23] === 1'b0, "PIN32 b01 TIM_EXT1: OE = 0");
        t_chk(o_tim_ext[1] === i_pad_in[23], "PIN32 b01 TIM_EXT1: Y");
      end
      2'b10: t_chk(o_pad_oe[23] === 1'b0, "PIN32 b10 unassigned: OE = 0");
      2'b11: t_chk(o_pad_oe[23] === 1'b0, "PIN32 b11 unassigned: OE = 0");
      default: t_chk(1'b0, "t_expect_pad: code is X");
    endcase
    24: case (c)  // PIN33
      2'b00: begin
        t_chk(o_pad_oe[24] === 1'b0, "PIN33 b00 TIM_EXT2: OE = 0");
        t_chk(o_tim_ext[2] === i_pad_in[24], "PIN33 b00 TIM_EXT2: Y");
      end
      2'b01: t_chk(o_pad_oe[24] === 1'b0, "PIN33 b01 unassigned: OE = 0");
      2'b10: t_chk(o_pad_oe[24] === 1'b0, "PIN33 b10 unassigned: OE = 0");
      2'b11: t_chk(o_pad_oe[24] === 1'b0, "PIN33 b11 unassigned: OE = 0");
      default: t_chk(1'b0, "t_expect_pad: code is X");
    endcase
    25: case (c)  // PIN34
      2'b00: begin
        t_chk(o_pad_oe[25] === 1'b0, "PIN34 b00 TIM_EXT3: OE = 0");
        t_chk(o_tim_ext[3] === i_pad_in[25], "PIN34 b00 TIM_EXT3: Y");
      end
      2'b01: t_chk(o_pad_oe[25] === 1'b0, "PIN34 b01 unassigned: OE = 0");
      2'b10: t_chk(o_pad_oe[25] === 1'b0, "PIN34 b10 unassigned: OE = 0");
      2'b11: t_chk(o_pad_oe[25] === 1'b0, "PIN34 b11 unassigned: OE = 0");
      default: t_chk(1'b0, "t_expect_pad: code is X");
    endcase
    26: case (c)  // PIN38
      2'b00: begin
        t_chk(o_pad_out[26] === (i_gpio_2_out[3]), "PIN38 b00 GPIO2_3: A");
        t_chk(o_pad_oe[26] === (i_gpio_2_oe[3]), "PIN38 b00 GPIO2_3: OE");
        t_chk(o_gpio_2_in[3] === i_pad_in[26], "PIN38 b00 GPIO2_3: Y");
      end
      2'b01: begin
        t_chk(o_pad_out[26] === (i_pwm[6]), "PIN38 b01 PWM_6: A");
        t_chk(o_pad_oe[26] === (1'b1), "PIN38 b01 PWM_6: OE");
      end
      2'b10: t_chk(o_pad_oe[26] === 1'b0, "PIN38 b10 unassigned: OE = 0");
      2'b11: t_chk(o_pad_oe[26] === 1'b0, "PIN38 b11 unassigned: OE = 0");
      default: t_chk(1'b0, "t_expect_pad: code is X");
    endcase
    27: case (c)  // PIN39
      2'b00: begin
        t_chk(o_pad_out[27] === (i_gpio_2_out[2]), "PIN39 b00 GPIO2_2: A");
        t_chk(o_pad_oe[27] === (i_gpio_2_oe[2]), "PIN39 b00 GPIO2_2: OE");
        t_chk(o_gpio_2_in[2] === i_pad_in[27], "PIN39 b00 GPIO2_2: Y");
      end
      2'b01: begin
        t_chk(o_pad_out[27] === (i_pwm[7]), "PIN39 b01 PWM_7: A");
        t_chk(o_pad_oe[27] === (1'b1), "PIN39 b01 PWM_7: OE");
      end
      2'b10: t_chk(o_pad_oe[27] === 1'b0, "PIN39 b10 unassigned: OE = 0");
      2'b11: t_chk(o_pad_oe[27] === 1'b0, "PIN39 b11 unassigned: OE = 0");
      default: t_chk(1'b0, "t_expect_pad: code is X");
    endcase
    default: t_chk(1'b0, "t_expect_pad: no such pad");
  endcase
endtask

// every IP input that no pad selects holds its idle value
task automatic t_expect_idle();
  if (r_sel_eff[7] != 2'b00) t_chk(o_gpio_0_in[0] === 1'b0, "GPIO0_0 not selected: idle 1'b0");
  if (r_sel_eff[6] != 2'b01) t_chk(o_gpio_0_in[1] === 1'b0, "GPIO0_1 not selected: idle 1'b0");
