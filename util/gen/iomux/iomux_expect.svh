  if (r_sel_eff[22] != 2'b01) t_chk(o_tim_ext[0] === 1'b0, "TIM_EXT0 not selected: idle 1'b0");
  if (r_sel_eff[23] != 2'b01) t_chk(o_tim_ext[1] === 1'b0, "TIM_EXT1 not selected: idle 1'b0");
  if (r_sel_eff[24] != 2'b00) t_chk(o_tim_ext[2] === 1'b0, "TIM_EXT2 not selected: idle 1'b0");
  if (r_sel_eff[25] != 2'b00) t_chk(o_tim_ext[3] === 1'b0, "TIM_EXT3 not selected: idle 1'b0");
  if (r_sel_eff[6] != 2'b00) t_chk(o_uart_0_rx === 1'b1, "UART0_RX not selected: idle 1'b1");
  if (r_sel_eff[14] != 2'b01) t_chk(o_uart_1_rx === 1'b1, "UART1_RX not selected: idle 1'b1");
endtask
