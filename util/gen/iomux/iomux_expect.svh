  if (r_sel_eff[22] != 2'b00) t_chk(o_gpio_2_in[1] === 1'b0, "GPIO2_1 not selected: idle 1'b0");
  if (r_sel_eff[27] != 2'b00) t_chk(o_gpio_2_in[2] === 1'b0, "GPIO2_2 not selected: idle 1'b0");
  if (r_sel_eff[26] != 2'b00) t_chk(o_gpio_2_in[3] === 1'b0, "GPIO2_3 not selected: idle 1'b0");
  if (r_sel_eff[21] != 2'b00) t_chk(o_gpio_2_in[4] === 1'b0, "GPIO2_4 not selected: idle 1'b0");
  if (r_sel_eff[20] != 2'b00) t_chk(o_gpio_2_in[5] === 1'b0, "GPIO2_5 not selected: idle 1'b0");
  if (r_sel_eff[19] != 2'b00) t_chk(o_gpio_2_in[6] === 1'b0, "GPIO2_6 not selected: idle 1'b0");
  if (r_sel_eff[18] != 2'b00) t_chk(o_gpio_2_in[7] === 1'b0, "GPIO2_7 not selected: idle 1'b0");
  if (r_sel_eff[14] != 2'b00) t_chk(o_i2c_scl === 1'b1, "I2C_SCL not selected: idle 1'b1");
  if (r_sel_eff[15] != 2'b00) t_chk(o_i2c_sda === 1'b1, "I2C_SDA not selected: idle 1'b1");
  if (r_sel_eff[0] != 2'b00) t_chk(o_jtag_tck === 1'b0, "TCK not selected: idle 1'b0");
